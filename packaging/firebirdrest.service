# Installed by the firebirdrest .deb and .rpm packages.
# Edit /etc/firebirdrest/firebirdrest.conf, then: systemctl enable --now firebirdrest
# Override settings with: systemctl edit firebirdrest
[Unit]
Description=FirebirdREST: a RESTful API for a Firebird database
Documentation=https://mariuz.github.io/firebirdrest/
After=network-online.target firebird.service firebird-superserver.service
Wants=network-online.target

[Service]
Type=exec
User=firebirdrest
Group=firebirdrest
ExecStartPre=/usr/bin/firebirdrest -check /etc/firebirdrest/firebirdrest.conf
ExecStart=/usr/bin/firebirdrest /etc/firebirdrest/firebirdrest.conf
# SIGHUP reloads the TLS certificate and the schema cache
ExecReload=/bin/sh -c 'kill -HUP $MAINPID'
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# to listen on a port below 1024 (server-port = 443), uncomment:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
